#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# homeproxy CLI -- manage HomeProxy on LuCI-less routers (MiWiFi).
# Usage: homeproxy <command> [args]
#   start|stop|restart|reload|status   service control
#   enable|disable                     boot autostart (writes UCI config.enabled;
#                                      disable also stops the service now)
#   firewall-stop                      tear down the firewall/DNS takeover ONLY
#                                      (meow keeps running; 'homeproxy restart'
#                                      restores it)
#   generate                           regenerate meow configs
#   check                              validate generated meow-*.yaml (meow -t)
#   migrate                            apply config defaults/migration
#   subscribe                          update subscriptions now
#   update-resources [all|china_ip4|china_ip6|gfw_list|china_list]
#   nodes                              list proxy nodes ([quarantined] = unsupported by meow)
#   node <name>                        show one node
#   main-node [name|urltest|nil]       get/set main node
#   routing-mode [mode]                get/set routing_mode
#   proxy-mode [redirect|tproxy|redirect_tproxy]
#                                      get/set proxy_mode: redirect = TCP only,
#                                      tproxy = UDP only, redirect_tproxy = both
#   lan-proxy [mode]                   get/set lan_proxy_mode
#   add <label> -- <type> <addr> <port> [key=val ...]
#   import <share-link> [...]          add nodes from ss:// vmess:// vless:// etc.
#   del <name>                         delete a node
#   set <section.option> <value>       set a uci option
#   get <section.option>               get a uci option
#   show                               dump the whole config
#   log [-f]                           show / tail the meow + homeproxy logs

set -u

CONF=homeproxy
INIT=/etc/init.d/$CONF
[ -f /etc/homeproxy/env.sh ] && . /etc/homeproxy/env.sh || true
LUA_DIR="${HP_LIB_DIR:-/usr/lib/homeproxy}"
export HP_LUAPATH="$LUA_DIR"
HP_DIR=/etc/homeproxy
RUN_DIR=/var/run/homeproxy
LOG_PATH=$RUN_DIR/$CONF.log

die() { echo "homeproxy: $*" >&2; exit 1; }
uci_set() { uci set "$CONF.$1=$2" 2>/dev/null && uci commit "$CONF"; }
uci_get() { uci -q get "$CONF.$1" 2>/dev/null; }

# uci truth-table (same vocabulary as init.d's config_get_bool / install.sh
# bool_on): only {1,yes,on,true,enabled} are true; every other spelling --
# including garbage values -- is false.
bool_on() {
    case "$1" in
        1|yes|on|true|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

# Section type check: node_exists <name> -> 0 iff homeproxy.<name> is a node.
node_exists() {
    [ "$(uci -q show "$CONF.$1" 2>/dev/null | awk -F= 'NR==1{print $2}')" = "node" ]
}

# True when $1 (a node section name) is still referenced by config options that
# would dangle if it were deleted. Prints the first referrer found.
node_referenced() {
    local n="$1" ref
    for ref in "config.main_node" "config.main_udp_node"; do
        [ "$(uci_get "$ref")" = "$n" ] && { echo "$ref"; return 0; }
    done
    # uci show renders scalars as key='name' and lists as key='a' 'name' 'b';
    # the name always appears quote-wrapped, so an exact-quoted match suffices.
    uci -q show "$CONF" 2>/dev/null | grep -qF "'$n'" && {
        echo "urltest/routing/dns reference"; return 0; }
    return 1
}

# Resolve the meow binary: env.sh (install.sh) may point at
# /data/other_vol/bin/meow; a standard package build uses /usr/bin/meow.
meow_bin() {
    local b="${HP_MEOW_BIN:-/usr/bin/meow}"
    [ -x "$b" ] || b="$(command -v meow 2>/dev/null || true)"
    [ -n "$b" ] && printf '%s\n' "$b"
}

# Quarantine file (spec 4.6): one JSON object per unsupported node, written
# by the generator / subscription updater; "name" is the UCI section name.
QUAR_FILE=$RUN_DIR/unsupported-nodes.json
quarantine_names() {
    [ -f "$QUAR_FILE" ] || return 0
    # Split on JSON structural characters so each "name" field lands on its
    # own line (works for compact or spaced encoders without grep -o).
    tr '{},' '\n\n\n\n' < "$QUAR_FILE" 2>/dev/null \
        | sed -n 's/^[ ]*"name"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}
# node_quarantined <section> -> 0 iff the node is recorded as quarantined.
node_quarantined() { quarantine_names | grep -qxF "$1"; }

# File-type rule-providers resolve `path` relative to the meow home dir
# (-d $RUN_DIR), so generated configs reference providers/<list>.txt while
# the canonical lists live in $HP_DIR/resources; sync the ones the current
# routing_mode can reference into providers/ and prune stale copies.
# SEMANTIC SOURCE = init.d sync_rule_files (contract C-B2-3): this is a
# faithful port -- keep the want/copy/prune rules item-for-item identical.
sync_providers() {
    local prov_dir="$RUN_DIR/providers" f want=""
    mkdir -p "$prov_dir" || return 0
    # china-domain/gfw-domain and the CN ipcidr lists may be referenced in
    # any routing_mode (rules and nameserver-policy); direct/proxy-domain
    # exist only while the user ships those lists; direct-ip/proxy-ip are
    # custom-mode only.
    want="china_list.txt gfw_list.txt china_ip4.txt china_ip6.txt"
    for f in direct_list.txt proxy_list.txt; do
        [ -s "$HP_DIR/resources/$f" ] && want="$want $f"
    done
    if [ "$1" = "custom" ]; then
        for f in direct_ip.txt proxy_ip.txt; do
            [ -s "$HP_DIR/resources/$f" ] && want="$want $f"
        done
    fi
    for f in $want; do
        if [ -f "$HP_DIR/resources/$f" ]; then
            cp -f "$HP_DIR/resources/$f" "$prov_dir/$f" 2>/dev/null
        else
            # A provider whose backing list vanished would fail `meow -t`;
            # drop the stale copy so the failure is one consistent error.
            rm -f "$prov_dir/$f"
            echo "homeproxy: warning: resource $f missing -- rule-providers referencing it will fail." >&2
        fi
    done
    # Prune stale copies of the known resource names (e.g. after a custom ->
    # bypass mode switch shrank the want set). Unknown files in providers/
    # (generator/user-placed) are left alone.
    for f in china_list.txt gfw_list.txt china_ip4.txt china_ip6.txt \
             direct_list.txt proxy_list.txt direct_ip.txt proxy_ip.txt; do
        case " $want " in
            *" $f "*) ;;
            *) rm -f "$prov_dir/$f" ;;
        esac
    done
}

# C-B2-2 same-generation rollback for `generate`: the meow-c.yaml and
# meow-s.yaml written by one run are a single generation, so ANY failure
# (gen nonzero, yaml missing, meow -t, server gen rc=1 -- including a
# server-side failure after the client already passed) must restore every
# .hp-prev snapshot taken THIS run, then die. cprev/sprev flag the snapshots
# taken this run; a failed/absent backup just means "no prev to restore".
gen_rollback() {
    [ "${cprev:-0}" = "1" ] && mv -f "$RUN_DIR/meow-c.yaml.hp-prev" "$RUN_DIR/meow-c.yaml"
    [ "${sprev:-0}" = "1" ] && mv -f "$RUN_DIR/meow-s.yaml.hp-prev" "$RUN_DIR/meow-s.yaml"
    return 0
}

cmd_status() {
    local st=stopped mb ver enabled
    # spec 8.4 unified probe: procd runs "meow -f /var/run/homeproxy/meow-{c,s}.yaml".
    pgrep -f "meow -f $RUN_DIR/meow-" >/dev/null 2>&1 && st=running
    echo "$st"
    # Unset means enabled (same default as the api's ${enabled:-1} and
    # init.d's config_get_bool ... "1").
    enabled=$(uci_get config.enabled)
    echo "enabled: ${enabled:-1}"
    mb="$(meow_bin)"
    ver=""
    [ -n "$mb" ] && ver="$("$mb" --version 2>/dev/null | sed -n '1p')"
    if [ -z "$ver" ]; then
        # Fallback: the running client instance's external-controller
        # answers /version even when the meow binary is missing or its
        # --version output is unusable. Fast-fails when meow is down.
        ver="$(curl -sf -m 3 "http://127.0.0.1:19290/version" 2>/dev/null \
            | sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p')"
        [ -n "$ver" ] && ver="meow $ver (api)"
    fi
    [ -n "$ver" ] && echo "version: $ver"
    if [ "$st" = "running" ]; then
        pgrep -f "meow -f $RUN_DIR/meow-c.yaml" >/dev/null 2>&1 && echo "client: running"
        pgrep -f "meow -f $RUN_DIR/meow-s.yaml" >/dev/null 2>&1 && echo "server: running"
    fi
    return 0
}

cmd_nodes() {
    # Space-wrapped quarantine name list for an exact-match index() lookup.
    local qnames=" $(quarantine_names | tr '\n' ' ')"
    echo "NAME                                LABEL                      TYPE        ADDRESS:PORT"
    # Collect fields per section and print on the next section boundary: uci
    # option order is not stable (subscription writes use pairs()), so a row
    # is only complete once the section ends. Values may contain '=' so the
    # split is on the FIRST '=' only.
    uci -q show "$CONF" 2>/dev/null | awk -v q="$qnames" '
        function pr() {
            gsub(/^[ \x27]+|[ \x27]+$/,"",label); gsub(/^[ \x27]+|[ \x27]+$/,"",type)
            gsub(/^[ \x27]+|[ \x27]+$/,"",addr);   gsub(/^[ \x27]+|[ \x27]+$/,"",port)
            printf "%-36s %-26s %-11s %s:%s%s\n", name, label, type, addr, port, \
                (index(q, " " name " ") > 0 ? "  [quarantined]" : "")
        }
        /^homeproxy\.[^.=]+=[^ \x27]+$/ {           # any section-type line
            if (name != "") pr()
            if ($0 ~ /=node$/) { name=$1; sub(/^homeproxy\./,"",name); sub(/=.*$/,"",name) } else name=""
            label=type=addr=port=""; next
        }
        name != "" {
            val=$0; sub(/^[^=]*=/,"",val)
            # Anchor on the section prefix: ".label=" inside a VALUE must
            # not be mistaken for the option name.
            if ($0 ~ /^homeproxy\.[^.]+\.label=/) label=val
            else if ($0 ~ /^homeproxy\.[^.]+\.type=/) type=val
            else if ($0 ~ /^homeproxy\.[^.]+\.address=/) addr=val
            else if ($0 ~ /^homeproxy\.[^.]+\.port=/) port=val
        }
        END { if (name != "") pr() }
    '
}

cmd_add() {
    local label="" rest=0 type addr port name
    while [ $# -gt 0 ]; do
        if [ "$1" = "--" ]; then rest=1; shift; break; fi
        [ -z "$label" ] && label="$1"; shift
    done
    [ "$rest" = "1" ] && [ $# -ge 3 ] || die "usage: homeproxy add <label> -- <type> <addr> <port> [key=val ...]"
    [ -n "$label" ] || die "add: a label is required"
    type="$1"; addr="$2"; port="$3"; shift 3
    # Only types the meow generator can emit (spec 4.4); hysteria(v1)/tuic/
    # wireguard/etc. would just be quarantined at generation, so reject them
    # here with a clear reason instead of writing a dead node.
    case "$type" in
        shadowsocks|vless|vmess|trojan|hysteria2|snell|anytls|socks|http) ;;
        *) die "unsupported node type: $type (supported: shadowsocks vless vmess trojan hysteria2 snell anytls socks http)" ;;
    esac
    case "$port" in ''|*[!0-9]*) die "invalid port: $port" ;; esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port out of range: $port"
    name="$(printf '%s' "$label" | md5sum | cut -c1-32)"
    if uci -q get "$CONF.$name" >/dev/null 2>&1; then
        # Upsert (same semantics as `homeproxy import`): wipe the old options
        # first so switching node type can't leave stale fields behind (e.g.
        # tls_* from a trojan node surviving onto a shadowsocks rewrite).
        node_exists "$name" || die "section $name exists and is not a node"
        for opt in $(uci -q show "$CONF.$name" 2>/dev/null | sed -n "s/^$CONF\.$name\.\([^.=]*\)=.*/\1/p"); do
            uci -q delete "$CONF.$name.$opt" 2>/dev/null
        done
    fi
    uci set "$CONF.$name=node" || die "failed to create node section"
    uci set "$CONF.$name.label=$label" || die "uci set label failed"
    uci set "$CONF.$name.type=$type" || die "uci set type failed"
    uci set "$CONF.$name.address=$addr" || die "uci set address failed"
    uci set "$CONF.$name.port=$port" || die "uci set port failed"
    for kv in "$@"; do
        case "$kv" in
            # Reserved keys would override the validated fields above.
            label=*|type=*|address=*|port=*)
                die "add: '$kv' duplicates a positional argument" ;;
            [a-zA-Z0-9_]*=*) uci set "$CONF.$name.$kv" || die "uci set failed: $kv" ;;
            *) echo "homeproxy: ignoring bad key=val '$kv'" >&2 ;;
        esac
    done
    uci commit "$CONF" || die "commit failed"
    echo "Added node '$label' as section $name. Run 'homeproxy generate' then restart."
}

cmd_del() {
    [ -n "$1" ] || die "usage: homeproxy del <name>"
    # Refuse non-node sections (config/infra/dns_server/...): deleting one
    # breaks generation entirely.
    node_exists "$1" || die "no such node (or not a node section): $1"
    local ref
    ref=$(node_referenced "$1")
    case "$ref" in
        config.main_node|config.main_udp_node)
            die "node $1 is still set as $ref -- set another node first" ;;
        "")
            : ;;
        *)
            echo "warning: $1 is still referenced by $ref" >&2 ;;
    esac
    uci delete "$CONF.$1" 2>/dev/null || die "delete failed: $1"
    uci commit "$CONF" || die "commit failed"
    echo "Deleted node $1."
}

cmd_set() {
    [ $# -ge 2 ] || die "usage: homeproxy set <section.option> <value>"
    local key="$1"; shift
    case "$key" in *.*) ;; *) die "key must be <section.option>" ;; esac
    # Validate the enum options that have dedicated commands -- a bad value
    # here breaks generation or silently changes steering semantics. Other
    # keys pass through as a raw escape hatch.
    case "$key" in
        config.routing_mode)
            case "$*" in bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom) ;;
                *) die "bad routing_mode: $*" ;; esac ;;
        config.proxy_mode)
            # New vocabulary only (spec 3.4): the removed TUN modes and the
            # old TCP+UDP meaning of "tproxy" are rejected, not rewritten.
            case "$*" in redirect|tproxy|redirect_tproxy) ;;
                *) die "bad proxy_mode: $* (redirect|tproxy|redirect_tproxy)" ;; esac ;;
        control.lan_proxy_mode)
            case "$*" in disabled|only_proxy|listed_only|except_listed) ;;
                *) die "bad lan_proxy_mode: $*" ;; esac ;;
        config.main_node)
            case "$*" in urltest|nil) ;; *)
                node_exists "$*" || die "no such node: $*"
                node_quarantined "$*" && echo "warning: node '$*' is quarantined (unsupported by meow) -- generation falls back to direct." >&2 ;; esac ;;
        config.main_udp_node)
            case "$*" in urltest|nil|same) ;; *)
                node_exists "$*" || die "no such node: $*"
                node_quarantined "$*" && echo "warning: node '$*' is quarantined (unsupported by meow) -- generation falls back to direct." >&2 ;; esac ;;
    esac
    uci_set "$key" "$*" || die "uci set failed: $key"
    echo "Set $key = $*"
}
cmd_get() { [ -n "$1" ] || die "usage: homeproxy get <section.option>"; uci_get "$1"; }

case "${1:-}" in
stop|reload) "$INIT" "$@" ;;
start|restart)
    "$INIT" "$@"
    rc=$?
    # rc=2 = "nothing to run" (nil outbound / enabled=0): a defined no-op, not
    # a failure (spec G9). Surface it so the CLI exit code is not mistaken.
    [ "$rc" = "2" ] && echo "nothing to run (no outbound/server) -- config saved"
    exit "$rc"
    ;;
status) cmd_status ;;
# The real autostart switch is UCI config.enabled (read by init.d start and
# boot_restore.sh on MiWiFi); the rc.d symlink toggles are kept so standard
# package installs behave the same as before.
enable)
    "$INIT" enable 2>/dev/null          # rc.d links (standard installs still use them)
    uci_set "config.enabled" "1" || die "uci set failed"
    echo "Enabled $CONF at boot (run 'homeproxy start' to start now)." ;;
disable)
    "$INIT" disable 2>/dev/null
    uci_set "config.enabled" "0" || die "uci set failed"
    "$INIT" stop >/dev/null 2>&1        # stop the bleeding now; rc.d alone is inert on MiWiFi
    echo "Disabled $CONF (boot_restore will not restart it)." ;;
firewall-stop)
    # Withdraw the takeover without touching the procd instance or UCI: if meow
    # is still alive, the mixed/API ports stay usable for diagnosis.
    WD=""
    for f in /etc/homeproxy/scripts/watchdog.sh \
             /data/other_vol/homeproxy/scripts/watchdog.sh; do
        [ -f "$f" ] && { WD="$f"; break; }
    done
    if [ -n "$WD" ]; then
        sh "$WD" degrade
    else
        # Inline same-order fallback (§3.3 contract): "script missing" must
        # never turn into "cannot tear down". mkdir first: ':' is a POSIX
        # special builtin, so a redirection failure on the marker below
        # would abort the whole script when RUN_DIR is absent (W3-2).
        mkdir -p "$RUN_DIR" 2>/dev/null
        rm -f "$RUN_DIR/firewall.active"
        for f in "$LUA_DIR/firewall.sh" \
                 /data/other_vol/homeproxy/lib/firewall.sh \
                 /usr/lib/homeproxy/firewall.sh; do
            [ -f "$f" ] && { sh "$f" stop; break; }
        done
        if ls /tmp/dnsmasq.d/homeproxy_*.conf >/dev/null 2>&1; then
            rm -f /tmp/dnsmasq.d/homeproxy_*.conf
            /etc/init.d/dnsmasq restart >/dev/null 2>&1
        fi
        : > "$RUN_DIR/hp_watchdog.degraded" || true
    fi
    echo "firewall teardown done (service untouched). 'homeproxy restart' to restore."
    ;;
generate)
    mkdir -p "$RUN_DIR"
    lua "$LUA_DIR/migrate_config.lua" || die "migrate failed"
    gen_c=0; gen_s=0; cprev=0; sprev=0
    # In custom routing mode the client config is needed even with main_node
    # unset: routing rules point at nodes directly.
    routing_mode="$(uci -q get $CONF.config.routing_mode 2>/dev/null)"
    if [ "$(uci -q get $CONF.config.main_node 2>/dev/null)" != "nil" ] || [ "$routing_mode" = "custom" ]; then
        # spec 4.7/C-B2-3: file rule-providers read their lists from
        # $RUN_DIR/providers/ -- sync before generation/validation (same
        # placement as init.d's sync_rule_files call in start_service).
        sync_providers "$routing_mode"
        # C-B2-2: snapshot the current yaml so a failure in this run can
        # restore the previous generation before dying (a cp failure just
        # leaves cprev=0 -- "no prev to restore", non-fatal).
        if [ -e "$RUN_DIR/meow-c.yaml" ]; then
            cp -f "$RUN_DIR/meow-c.yaml" "$RUN_DIR/meow-c.yaml.hp-prev" 2>/dev/null && cprev=1
        fi
        lua "$LUA_DIR/generate_client.lua" || { gen_rollback; die "client generation failed"; }
        [ -f "$RUN_DIR/meow-c.yaml" ] || { gen_rollback; die "meow-c.yaml missing after generation"; }
        gen_c=1
    fi
    # Server-enabled gate (spec C3): run the server generator when EITHER the
    # named `homeproxy.server.enabled` master switch is uci-true OR any
    # type=server listener section has enabled uci-true ({1,yes,on,true,
    # enabled}, same as init.d config_get_bool / install.sh bool_on). The two
    # are independent section kinds
    # (config homeproxy 'server' vs config server 'name'), so the disjunction
    # must cover both -- same formula as init.d's server_enabled probe. The
    # section walk is the same sed pipeline firewall.sh apply_fw_pre uses;
    # every uci probe is best-effort (errors swallowed).
    srv_en=0
    bool_on "$(uci -q get $CONF.server.enabled 2>/dev/null)" && srv_en=1
    if [ "$srv_en" != "1" ]; then
        for sect in $(uci -q show "$CONF" 2>/dev/null | sed -n "s/^homeproxy\.\([^.]*\)=server/\1/p"); do
            bool_on "$(uci -q get "$CONF.$sect.enabled" 2>/dev/null)" && srv_en=1
        done
    fi
    if [ "$srv_en" = "1" ]; then
        if [ -e "$RUN_DIR/meow-s.yaml" ]; then
            cp -f "$RUN_DIR/meow-s.yaml" "$RUN_DIR/meow-s.yaml.hp-prev" 2>/dev/null && sprev=1
        fi
        # rc split (spec 8.1/F7): 2 = enabled sections existed but all were
        # quarantined -> warn and continue client-only (NOT a failure: no
        # rollback); 1 = real failure -> roll back BOTH yamls, then die.
        gen_s_rc=0
        lua "$LUA_DIR/generate_server.lua" || gen_s_rc=$?
        case "$gen_s_rc" in
            0)
                [ -f "$RUN_DIR/meow-s.yaml" ] || { gen_rollback; die "meow-s.yaml missing after generation"; }
                gen_s=1 ;;
            2) echo "homeproxy: no usable server listeners (all enabled server" >&2
               echo "  sections were quarantined) -- continuing without meow-s.yaml" >&2 ;;
            *) gen_rollback; die "server generation failed" ;;
        esac
    fi
    # Validate with meow when available so a bad config is caught here, not
    # at the next service start. Only files generated in THIS run are checked
    # -- a stale meow-s.yaml from a now-disabled server must not fail it.
    MB="$(meow_bin)"
    if [ -n "$MB" ]; then
        if [ "$gen_c" = "1" ]; then
            if ! "$MB" -f "$RUN_DIR/meow-c.yaml" -t -d "$RUN_DIR"; then
                # A bad *unused* node (materialized as a probe outbound) can
                # fail the whole-config check; retry once without them, same
                # contract as init.d (spec 8.1/8.2, HP_MATERIALIZE_ALL_NODES).
                if [ "${HP_MATERIALIZE_ALL_NODES:-1}" != "0" ]; then
                    echo "homeproxy: meow -t failed; retrying with HP_MATERIALIZE_ALL_NODES=0" >&2
                    HP_MATERIALIZE_ALL_NODES=0 lua "$LUA_DIR/generate_client.lua" || { gen_rollback; die "client regeneration failed"; }
                    if [ ! -f "$RUN_DIR/meow-c.yaml" ] || ! "$MB" -f "$RUN_DIR/meow-c.yaml" -t -d "$RUN_DIR"; then
                        gen_rollback
                        die "meow -t failed: meow-c.yaml"
                    fi
                else
                    gen_rollback
                    die "meow -t failed: meow-c.yaml"
                fi
            fi
        fi
        if [ "$gen_s" = "1" ]; then
            if ! "$MB" -f "$RUN_DIR/meow-s.yaml" -t -d "$RUN_DIR"; then
                gen_rollback
                die "meow -t failed: meow-s.yaml"
            fi
        fi
    fi
    # The generation pair is final -- drop the snapshots (this also sweeps
    # stale .hp-prev files left behind by a SIGKILLed earlier run).
    rm -f "$RUN_DIR/meow-c.yaml.hp-prev" "$RUN_DIR/meow-s.yaml.hp-prev"
    # spec 8.2: surface the quarantine summary so dropped nodes are visible.
    qn="$(quarantine_names | grep -c .)"
    [ "$qn" -gt 0 ] && echo "homeproxy: $qn node(s) quarantined (unsupported by meow) -- see $QUAR_FILE"
    echo "Configs generated in $RUN_DIR."
    ;;
check)
    MB="$(meow_bin)"
    [ -n "$MB" ] || die "meow binary not found"
    found=0; rc=0
    for f in "$RUN_DIR/meow-c.yaml" "$RUN_DIR/meow-s.yaml"; do
        [ -f "$f" ] || continue
        found=1
        if "$MB" -f "$f" -t -d "$RUN_DIR"; then echo "$f: OK"; else echo "$f: FAILED" >&2; rc=1; fi
    done
    if [ "$found" = "0" ]; then
        echo "no generated configs in $RUN_DIR (run: homeproxy generate)"
        rc=1
    fi
    exit "$rc"
    ;;
migrate) lua "$LUA_DIR/migrate_config.lua" && echo "Migration applied." ;;
# Run the node-name migration first: an update fired between a package
# upgrade and the first service start would otherwise see only old-style
# section names and rebuild every node (losing the selected main_node).
subscribe) lua "$LUA_DIR/migrate_config.lua" || die "migrate failed"; lua "$LUA_DIR/update_subscriptions.lua" ;;
update-resources)
    shift
    if [ -z "${1:-}" ] || [ "${1:-}" = "all" ]; then
        for i in china_ip4 china_ip6 gfw_list china_list; do "$HP_DIR/scripts/update_resources.sh" "$i"; done
    else "$HP_DIR/scripts/update_resources.sh" "$1"; fi
    ;;
nodes) cmd_nodes ;;
node)
    [ -n "${2:-}" ] || die "usage: homeproxy node <name>"
    uci -q show "$CONF.$2" 2>/dev/null || die "no such section: $2"
    node_quarantined "$2" && echo "# quarantined: unsupported by meow (see $QUAR_FILE)" || true ;;
main-node)
    if [ -z "${2:-}" ]; then uci_get "config.main_node"; else
        case "$2" in urltest|nil) ;; *)
            node_exists "$2" || die "no such node: $2"
            node_quarantined "$2" && echo "warning: node '$2' is quarantined (unsupported by meow) -- generation falls back to direct." >&2 ;; esac
        uci_set "config.main_node" "$2" || die "set failed"; echo "main_node=$2"
    fi ;;
routing-mode)
    if [ -z "${2:-}" ]; then uci_get "config.routing_mode"; else
        case "$2" in bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom) ;; *) die "bad routing_mode: $2 (bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom)" ;; esac
        uci_set "config.routing_mode" "$2" || die "set failed"; echo "routing_mode=$2"
    fi ;;
proxy-mode)
    if [ -z "${2:-}" ]; then uci_get "config.proxy_mode"; else
        # New vocabulary (spec 3.4): redirect = TCP REDIRECT arm only;
        # tproxy = UDP TPROXY arm only (TCP is NOT intercepted);
        # redirect_tproxy = both. TUN modes were removed.
        case "$2" in redirect|tproxy|redirect_tproxy) ;;
            *) die "bad proxy_mode: $2 (redirect|tproxy|redirect_tproxy)" ;; esac
        if [ "$2" = "tproxy" ]; then
            mun=$(uci_get "config.main_udp_node"); mun=${mun:-nil}
            rmod=$(uci_get "config.routing_mode"); rmod=${rmod:-bypass_mainland_china}
            if [ "$mun" = "nil" ] && [ "$rmod" != "custom" ]; then
                echo "warning: proxy_mode=tproxy steers UDP only; with main_udp_node=nil and" >&2
                echo "  a non-custom routing_mode the firewall intercepts NO traffic at all." >&2
            fi
        fi
        uci_set "config.proxy_mode" "$2" || die "set failed"; echo "proxy_mode=$2"
    fi ;;
lan-proxy)
    if [ -z "${2:-}" ]; then uci_get "control.lan_proxy_mode"; else
        # Same value set as the web UI / API / firewall gate.
        case "$2" in disabled|only_proxy|listed_only|except_listed) ;; *) die "bad lan_proxy_mode: $2 (disabled|only_proxy|listed_only|except_listed)" ;; esac
        uci_set "control.lan_proxy_mode" "$2" || die "set failed"; echo "lan_proxy_mode=$2"
    fi ;;
add) shift; cmd_add "$@" ;;
import) shift; [ $# -ge 1 ] || die "usage: homeproxy import <share-link> [more links...]"; printf '%s\n' "$@" | lua "$LUA_DIR/add_nodes.lua" ;;
del) cmd_del "${2:-}" ;;
set) shift; cmd_set "$@" ;;
get) cmd_get "${2:-}" ;;
show) uci -q show "$CONF" ;;
log)
    # meow kernel logs (procd stdout/stderr) plus our own homeproxy.log,
    # which carries the lua/shell warnings.
    if [ "${2:-}" = "-f" ]; then
        lf=""
        for f in "$RUN_DIR/meow-c.log" "$RUN_DIR/meow-s.log" "$LOG_PATH"; do
            [ -f "$f" ] && lf="$lf $f"
        done
        if [ -n "$lf" ]; then tail -F $lf; else echo "no log yet"; fi
    else
        shown=0
        for f in "$RUN_DIR/meow-c.log" "$RUN_DIR/meow-s.log" "$LOG_PATH"; do
            if [ -f "$f" ]; then
                [ "$shown" = "1" ] && echo
                echo "== $f =="
                tail -n 50 "$f"
                shown=1
            fi
        done
        if [ "$shown" = "0" ]; then echo "no log yet"; fi
    fi ;;
""|-h|--help|help) sed -n '4,31p' "$0" 2>/dev/null ;;
*) die "unknown command '${1:-}' (try: homeproxy help)" ;;
esac